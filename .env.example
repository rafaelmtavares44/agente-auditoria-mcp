# Copie para .env e preencha. NUNCA versione o .env.
# A chave fica SOMENTE no processo do orquestrador; o servidor MCP não a recebe.
ANTHROPIC_API_KEY=
# Identificador do modelo — PENDENTE DE VALIDAÇÃO com a chave da equipe.
# Candidato listado na documentação oficial em 23/09/2026 (platform.claude.com/docs/en/models/overview):
#   claude-sonnet-5  (equilíbrio custo/qualidade)   |   claude-haiku-4-5-20251001  (mais barato)
# Confirme que o ID está disponível na sua conta antes da demonstração.
ANTHROPIC_MODEL=

# Retentativas do SDK para erros transitórios (429, 5xx, rede)
AGENT_MAX_RETRIES=2

# Limites do agente (os valores abaixo são os padrões do código)
AGENT_MAX_ITERATIONS=15
AGENT_MAX_TOOL_CALLS=30
AGENT_MAX_OUTPUT_TOKENS=8192
AGENT_MAX_TOTAL_TOKENS=300000
AGENT_TIMEOUT_SECONDS=600
